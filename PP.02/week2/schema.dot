digraph S {
 graph [rankdir=LR, fontname="DejaVu Sans", nodesep=0.5, ranksep=1.1, dpi=150];
 node [shape=plaintext, fontname="DejaVu Sans", fontsize=11];
 edge [arrowhead=crowodot, arrowtail=teetee, dir=both, color="#444444"];
 roles [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="3" bgcolor="#cfe2f3"><b>cafe.roles</b></td></tr><tr><td align="left">PK</td><td align="left"><b>id</b></td><td align="left">smallint</td></tr><tr><td align="left">UQ</td><td align="left">name</td><td align="left">character varying(30)</td></tr></table>>];
 users [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="3" bgcolor="#cfe2f3"><b>cafe.users</b></td></tr><tr><td align="left">PK</td><td align="left"><b>id</b></td><td align="left">integer</td></tr><tr><td align="left">UQ</td><td align="left">login</td><td align="left">character varying(50)</td></tr><tr><td align="left"></td><td align="left">password_hash</td><td align="left">character varying(255)</td></tr><tr><td align="left"></td><td align="left">full_name</td><td align="left">character varying(100)</td></tr><tr><td align="left">FK</td><td align="left">role_id</td><td align="left">smallint</td></tr></table>>];
 guests [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="3" bgcolor="#cfe2f3"><b>cafe.guests</b></td></tr><tr><td align="left">PK</td><td align="left"><b>id</b></td><td align="left">integer</td></tr><tr><td align="left"></td><td align="left">full_name</td><td align="left">character varying(100)</td></tr><tr><td align="left">UQ</td><td align="left">phone</td><td align="left">character varying(12)</td></tr><tr><td align="left"></td><td align="left">email</td><td align="left">character varying(100) NULL</td></tr></table>>];
 halls [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="3" bgcolor="#cfe2f3"><b>cafe.halls</b></td></tr><tr><td align="left">PK</td><td align="left"><b>id</b></td><td align="left">smallint</td></tr><tr><td align="left">UQ</td><td align="left">name</td><td align="left">character varying(50)</td></tr><tr><td align="left"></td><td align="left">description</td><td align="left">text NULL</td></tr></table>>];
 cafe_tables [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="3" bgcolor="#cfe2f3"><b>cafe.cafe_tables</b></td></tr><tr><td align="left">PK</td><td align="left"><b>id</b></td><td align="left">integer</td></tr><tr><td align="left">FK UQ</td><td align="left">hall_id</td><td align="left">smallint</td></tr><tr><td align="left">UQ</td><td align="left">number</td><td align="left">smallint</td></tr><tr><td align="left"></td><td align="left">capacity</td><td align="left">smallint</td></tr></table>>];
 bookings [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="3" bgcolor="#f9cb9c"><b>cafe.bookings</b></td></tr><tr><td align="left">PK</td><td align="left"><b>id</b></td><td align="left">bigint</td></tr><tr><td align="left">FK</td><td align="left">guest_id</td><td align="left">integer</td></tr><tr><td align="left">FK</td><td align="left">table_id</td><td align="left">integer</td></tr><tr><td align="left">FK</td><td align="left">user_id</td><td align="left">integer</td></tr><tr><td align="left"></td><td align="left">booking_date</td><td align="left">date</td></tr><tr><td align="left"></td><td align="left">time_start</td><td align="left">time(0) without time zone</td></tr><tr><td align="left"></td><td align="left">time_end</td><td align="left">time(0) without time zone</td></tr><tr><td align="left"></td><td align="left">guests_count</td><td align="left">smallint</td></tr><tr><td align="left"></td><td align="left">status</td><td align="left">character varying(10)</td></tr><tr><td align="left"></td><td align="left">created_at</td><td align="left">timestamp with time zone</td></tr></table>>];
 cafe_tables -> bookings;
 guests -> bookings;
 halls -> cafe_tables;
 roles -> users;
 users -> bookings;
}