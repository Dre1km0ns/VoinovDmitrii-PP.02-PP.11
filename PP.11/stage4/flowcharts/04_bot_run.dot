digraph G {
  graph [fontname="DejaVu Sans", nodesep=0.22, ranksep=0.28, splines=ortho, newrank=true];
  node  [fontname="DejaVu Sans", fontsize=13, shape=box, width=1.2, margin="0.08,0.04"];
  edge  [fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];

  s [shape=box, style="rounded", peripheries=1, label="Начало\nBookingBot.run(group_id)", group="main"];
  p0 [shape=polygon, sides=4, skew=0.2, margin="0.04,0.04", label="server =\ngroups.getLongPollServer", group="main"];
  x0 [shape=box, style="rounded", peripheries=1, label="VkError (например, 15 —\nнет права\n«Управление\nсообществом»): выход"];
  d0 [shape=diamond, margin=0.01, label="stop()?", group="main"];
  p1 [shape=polygon, sides=4, skew=0.2, margin="0.04,0.04", label="GET server: act=a_check,\nkey, ts, wait=25\n(timeout 35 с)", group="main"];
  d1 [shape=diamond, margin=0.01, label="Сбой сети\nили не JSON?", group="main"];
  w1 [shape=box, label="Журнал: «Long Poll\nнедоступен»\nпауза 3 с"];
  d2 [shape=diamond, margin=0.01, label="В ответе\nесть failed?", group="main"];
  d3 [shape=diamond, margin=0.01, label="failed = 1?"];
  p2 [shape=box, label="ts = r.ts"];
  p3 [shape=polygon, sides=4, skew=0.2, margin="0.04,0.04", label="server =\ngroups.getLongPollServer"];
  w2 [shape=box, label="VkError → журнал: «Не\nудалось обновить\nсервер Long Poll», пауза\n3 с"];
  p4 [shape=box, label="ts = r.ts", group="main"];
  d4 [shape=diamond, margin=0.01, label="Есть ещё\nсобытие в\nupdates?", group="main"];
  d5 [shape=diamond, margin=0.01, label="type =\nmessage_event?", group="main"];
  p5 [shape=box, peripheries=2, label="handle_event(событие)", group="main"];
  d6 [shape=diamond, margin=0.01, label="Исключение\nVkError\nили\nsqlite3.Error?", group="main"];
  l1 [shape=box, label="Журнал: ошибка обработки\nкнопки"];
  l2 [shape=box, label="Журнал: итог обработки", group="main"];
  end [shape=box, style="rounded", peripheries=1, label="Конец"];
  s -> p0 [];
  p0 -> x0 [xlabel="ошибка", style=dashed];
  p0 -> d0 [];
  d0 -> end [xlabel="да"];
  d0 -> p1 [xlabel="нет"];
  p1 -> d1 [];
  d1 -> w1 [xlabel="да"];
  w1 -> d0 [];
  d1 -> d2 [xlabel="нет"];
  d2 -> d3 [xlabel="да"];
  d3 -> p2 [xlabel="да"];
  d3 -> p3 [xlabel="нет"];
  p3 -> w2 [xlabel="ошибка", style=dashed];
  p3 -> d0 [];
  w2 -> d0 [];
  p2 -> d0 [];
  d2 -> p4 [xlabel="нет"];
  p4 -> d4 [];
  d4 -> d0 [xlabel="нет"];
  d4 -> d5 [xlabel="да"];
  d5 -> d4 [xlabel="нет"];
  d5 -> p5 [xlabel="да"];
  p5 -> d6 [];
  d6 -> l1 [xlabel="да"];
  d6 -> l2 [xlabel="нет"];
  l1 -> d4 [];
  l2 -> d4 [];
}