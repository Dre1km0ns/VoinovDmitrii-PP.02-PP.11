digraph G {
  graph [fontname="DejaVu Sans", nodesep=0.22, ranksep=0.28, splines=ortho, newrank=true];
  node  [fontname="DejaVu Sans", fontsize=13, shape=box, width=1.2, margin="0.08,0.04"];
  edge  [fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];

  s [shape=box, style="rounded", peripheries=1, label="Начало\nnotify_admins(booking)", group="main"];
  d0 [shape=diamond, margin=0.01, label="notifier\nнастроен?", group="main"];
  rf [shape=polygon, sides=4, skew=0.2, margin="0.04,0.04", label="Вернуть False"];
  p1 [shape=box, label="send_booking: текст\nformat_booking,\nклавиатура\nbooking_keyboard,\nrandom_id (один на все\nповторы)", group="main"];
  p2 [shape=box, label="VkApi.call(«messages.sen\nd»)\nattempt = 1", group="main"];
  p3 [shape=polygon, sides=4, skew=0.2, margin="0.04,0.04", label="POST https://api.vk.ru/m\nethod/messages.send\n(timeout = VK_TIMEOUT)", group="main"];
  d1 [shape=diamond, margin=0.01, label="Сбой сети, тайм-\nаут\nили ответ не\nJSON?", group="main"];
  d2 [shape=diamond, margin=0.01, label="Ответ — объект\nс response или\nerror?", group="main"];
  pn [shape=box, label="err = VkError(«network»)"];
  d3 [shape=diamond, margin=0.01, label="В ответе\nесть error?", group="main"];
  pe [shape=box, label="err = VkError(код,\nтекст)"];
  d4 [shape=diamond, margin=0.01, label="Код 6, 9 или 10\n(временная\nошибка)?"];
  d5 [shape=diamond, margin=0.01, label="attempt =\nattempts (3)?"];
  p4 [shape=box, label="Журнал: предупреждение;\nпауза attempt секунд;\nattempt = attempt + 1"];
  ok [shape=box, label="Журнал: «Бронь №N\nотправлена»", group="main"];
  rt [shape=polygon, sides=4, skew=0.2, margin="0.04,0.04", label="Вернуть True", group="main"];
  err [shape=box, label="Исключение VkError →\nжурнал: «Бронь №N не\nотправлена в ВК»"];
  unk [shape=box, label="Другое исключение →\nжурнал: непредвиденная\nошибка"];
  rf2 [shape=polygon, sides=4, skew=0.2, margin="0.04,0.04", label="Вернуть False\n(бронь остаётся «новой»)"];
  end [shape=box, style="rounded", peripheries=1, label="Конец", group="main"];
  s -> d0 [];
  d0 -> rf [xlabel="нет"];
  d0 -> p1 [xlabel="да"];
  p1 -> p2 [];
  p2 -> p3 [];
  p3 -> d1 [];
  d1 -> pn [xlabel="да"];
  d1 -> d2 [xlabel="нет"];
  d2 -> pn [xlabel="нет"];
  d2 -> d3 [xlabel="да"];
  d3 -> ok [xlabel="нет"];
  d3 -> pe [xlabel="да"];
  pe -> d4 [];
  d4 -> err [xlabel="нет"];
  d4 -> d5 [xlabel="да"];
  pn -> d5 [];
  d5 -> err [xlabel="да"];
  d5 -> p4 [xlabel="нет"];
  p4 -> p3 [];
  ok -> rt [];
  p1 -> unk [xlabel="исключение", style=dashed];
  err -> rf2 [];
  unk -> rf2 [];
  rt -> end [];
  rf -> end [];
  rf2 -> end [];
}