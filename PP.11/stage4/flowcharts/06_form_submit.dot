digraph G {
  graph [fontname="DejaVu Sans", nodesep=0.22, ranksep=0.28, splines=ortho, newrank=true];
  node  [fontname="DejaVu Sans", fontsize=13, shape=box, width=1.2, margin="0.08,0.04"];
  edge  [fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];

  s [shape=box, style="rounded", peripheries=1, label="Начало\nотправка формы контактов", group="main"];
  p0 [shape=box, label="Очистить ошибки; body =\nзапрос шага 1\n+ table_id, ФИО,\nтелефон, email", group="main"];
  d0 [shape=diamond, margin=0.01, label="ФИО\nпустое?", group="main"];
  e0 [shape=polygon, sides=4, skew=0.2, margin="0.04,0.04", label="Ошибка у поля ФИО\n«Укажите ФИО»"];
  p1 [shape=box, label="Кнопка «Забронировать»\nнеактивна", group="main"];
  p2 [shape=polygon, sides=4, skew=0.2, margin="0.04,0.04", label="fetch POST /api/bookings", group="main"];
  d1 [shape=diamond, margin=0.01, label="Сервер\nответил?", group="main"];
  e1 [shape=box, label="Ошибка «Сервер\nнедоступен. Проверьте\nсоединение и попробуйте\nещё раз»"];
  d2 [shape=diamond, margin=0.01, label="resp.ok\n(код 2xx)?", group="main"];
  ok [shape=polygon, sides=4, skew=0.2, margin="0.04,0.04", label="Шаг 4: «Заявка №N\nпринята»,\nданные гостя\nэкранированы (esc)", group="main"];
  d3 [shape=diamond, margin=0.01, label="Код 409?"];
  e2 [shape=box, label="loadScheme(), шаг 2\n(схема зала),\n«…Выберите другой\nстолик»"];
  d4 [shape=diamond, margin=0.01, label="В тексте\n«ФИО»?"];
  e3 [shape=polygon, sides=4, skew=0.2, margin="0.04,0.04", label="Ошибка у поля ФИО"];
  d5 [shape=diamond, margin=0.01, label="В тексте\n«Телефон»?"];
  e4 [shape=polygon, sides=4, skew=0.2, margin="0.04,0.04", label="Ошибка у поля «Телефон»"];
  e5 [shape=polygon, sides=4, skew=0.2, margin="0.04,0.04", label="Общее сообщение об\nошибке"];
  p3 [shape=box, label="Кнопка «Забронировать»\nснова активна", group="main"];
  end [shape=box, style="rounded", peripheries=1, label="Конец", group="main"];
  s -> p0 [];
  p0 -> d0 [];
  d0 -> e0 [xlabel="да"];
  e0 -> end [];
  d0 -> p1 [xlabel="нет"];
  p1 -> p2 [];
  p2 -> d1 [];
  d1 -> e1 [xlabel="нет"];
  d1 -> d2 [xlabel="да"];
  d2 -> ok [xlabel="да"];
  d2 -> d3 [xlabel="нет"];
  e1 -> d3 [];
  d3 -> e2 [xlabel="да"];
  d3 -> d4 [xlabel="нет"];
  d4 -> e3 [xlabel="да"];
  d4 -> d5 [xlabel="нет"];
  d5 -> e4 [xlabel="да"];
  d5 -> e5 [xlabel="нет"];
  ok -> p3 [];
  e2 -> p3 [];
  e3 -> p3 [];
  e4 -> p3 [];
  e5 -> p3 [];
  p3 -> end [];
}