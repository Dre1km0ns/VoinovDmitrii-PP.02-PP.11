# Пример настроек ВКонтакте. Скопируйте в .env и подставьте свои значения.
# Файл .env в репозиторий не добавляется (см. .gitignore).
VK_TOKEN=<токен сообщества с правом «Сообщения сообщества»>
VK_GROUP_ID=<id сообщества, число>
VK_PEER_ID=2000000001
